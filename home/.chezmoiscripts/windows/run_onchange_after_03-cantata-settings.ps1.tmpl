Set-ItemProperty -Path $proxy -Name "password" -Value "" -Type String

# Page settings
function Ensure-Path {
    param([string]$path)
    if (-not (Test-Path $path)) { New-Item -Path $path -Force | Out-Null }
}

function Set-Props {
    param([string]$path, [hashtable]$props)
    Ensure-Path $path
    foreach ($kv in $props.GetEnumerator()) {
        Set-ItemProperty -Path $path -Name $kv.Key -Value $kv.Value[0] -Type $kv.Value[1]
    }
}

