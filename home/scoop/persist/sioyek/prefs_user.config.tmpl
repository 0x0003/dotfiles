{{- $s := index .theme.palettes .active_theme "applications" "sioyek" -}}
{{- $bg := index $s "background_color" -}}
{{- $dmbg := index $s "dark_mode_background_color" -}}
{{- $sbc := index $s "status_bar_color" -}}
{{- $sbt := index $s "status_bar_text_color" -}}
check_for_updates_on_startup 0

background_color {{ index $bg 0 }} {{ index $bg 1 }} {{ index $bg 2 }}

dark_mode_background_color {{ index $dmbg 0 }} {{ index $dmbg 1 }} {{ index $dmbg 2 }}

sort_bookmarks_by_location 0

ui_font IosevkaCustom
font_size 16
status_bar_font_size 14

status_bar_color {{ index $sbc 0 }} {{ index $sbc 1 }} {{ index $sbc 2 }}
status_bar_text_color {{ index $sbt 0 }} {{ index $sbt 1 }} {{ index $sbt 2 }}
{{ if $s.dark }}
startup_commands toggle_dark_mode
{{ end -}}

