{{- if eq .os_id "windows" }}
Set colProcesses = GetObject("winmgmts:\\.\root\cimv2").ExecQuery("SELECT Name FROM Win32_Process WHERE Name = 'slskd.exe'")
If colProcesses.Count > 0 Then WScript.Quit
Set WshShell = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
Dim userProfile
userProfile = WshShell.ExpandEnvironmentStrings("%USERPROFILE%")

slskdDir = "F:\Music\_slskd"
If Not fso.FolderExists(slskdDir) Then
    fso.CreateFolder(slskdDir)
End If

incompleteDir = slskdDir & "\incomplete"
downloadsDir = slskdDir & "\downloads"
If Not fso.FolderExists(incompleteDir) Then
    fso.CreateFolder(incompleteDir)
End If
If Not fso.FolderExists(downloadsDir) Then
    fso.CreateFolder(downloadsDir)
End If

WshShell.Run userProfile & "\scoop\apps\slskd\current\slskd.exe --config """ & userProfile & "\.config\slskd\config.yml""", 0, False
{{ end -}}
