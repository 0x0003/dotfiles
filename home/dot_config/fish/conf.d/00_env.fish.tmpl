set -x PATH ~/scripts \
  {{ if .is_wsl -}} ~/scripts/wsl \
  {{ end -}} $PATH
{{ if .use_home_manager }}
if not contains $HOME/.nix-profile/share/fish/vendor_completions.d $fish_complete_path
  set -ga fish_complete_path $HOME/.nix-profile/share/fish/vendor_completions.d
end
{{ end }}
export EDITOR='nvim'

# bc - math lib, quiet, bcrc file
export BC_ENV_ARGS="-lq $HOME/.config/bc/calc"

# IME
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export DefaultIMModule=fcitx
export SDL_IM_MODULE=fcitx

# explicitly indicate truecolor support
export COLORTERM='truecolor'

# rg config
export RIPGREP_CONFIG_PATH="$HOME/.config/rg/rg.conf"

# ncurses programs by default have 100ms delay when pressing escape
export ESCDELAY=0

# mpd
export MPD_HOST={{ if .is_wsl }}{{ .windows_gateway }}{{ else }}127.0.0.1{{ end }}
export MPD_PORT=6600

# musicbrainz
export MUSICBRAINZ_USER={{ decrypt (include "secrets/musicbrainz-usr.age") | trim }}

# proxy
export PROXYADDRESS=http://{{ if .is_wsl }}{{ .windows_gateway }}{{ else }}127.0.0.1{{ end }}:2080
export PROXYBYPASS=localhost,127.0.0.1{{ if .is_wsl }},{{ .windows_gateway }}{{end}}

if test -f $HOME/.cache/fish/prx_state
  set -x NO_PROXY $PROXYBYPASS
  set -x http_proxy $PROXYADDRESS
  set -x https_proxy $PROXYADDRESS
  set -x HTTP_PROXY $PROXYADDRESS
  set -x HTTPS_PROXY $PROXYADDRESS
  set -x all_proxy $PROXYADDRESS
  set -x SSH_PROXY (string replace 'http://' '' -- $PROXYADDRESS)
end

