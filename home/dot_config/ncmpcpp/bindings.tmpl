def_key "space"
  pause

def_key "j"
  scroll_down

def_key "k"
  scroll_up

def_key "ctrl-u"
  page_up

def_key "ctrl-d"
  page_up

def_key "h"
  seek_backward

def_key "l"
  seek_forward

def_key "J"
  volume_down

def_key "K"
  volume_up

def_key "g"
  move_home

def_key "G"
  move_end

def_key "ctrl-e"
  jump_to_playing_song

def_key "d"
  delete_playlist_items

def_key "d"
  delete_browser_items

def_key "s"
  select_item

def_key "S"
  remove_selection

def_key "n"
  next_found_item

def_key "N"
  previous_found_item
{{- if .use_home_manager }}

def_key "alt-e"
    rate_remove

def_key "alt-r"
    rate_ten
{{- end }}

